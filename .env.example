# KKI pipeline — for local runs, merge into the parent repository `.env` (folder that contains `khobz-index/`, i.e. `../.env` from this directory; never commit real secrets).
# Verified URLs: see `docs/architecture/stack.md` §3.

# FAO FPI — primary JSON and optional CSV bulk
FAO_FPI_JSON_URL=
FAO_FPI_CSV_URL=

# FAOSTAT consumer prices (CP domain). Use either URL (live / bulk-hosted) OR a local JSON envelope.
FAOSTAT_CP_JSON_URL=
# Path relative to `process.cwd()` (run `cd khobz-index` before `bun run pipeline`).
# Bulk export must serialize as `{ \"data\": [ { area_code, item_code, year, months, value, currency, … } ] }`
# compatible with `src/adapters/faostat.ts`. Refresh steps: parent `docs/kki/kki-data-quality.md`.
FAOSTAT_CP_JSON_PATH=data/reference/faostat-pp-backfill.json

# Historical CPI envelope for pre-local KKI backcast (World Bank WDI; refresh via pipeline:prefetch-cpi)
HISTORICAL_CPI_JSON_PATH=data/reference/historical-cpi-envelope.json

# WFP VAM DataBridges — OAuth2 client credentials + data endpoint path you register
WFP_CLIENT_ID=
WFP_CLIENT_SECRET=
WFP_TOKEN_URL=https://api.wfp.org/token
WFP_VAM_DATA_URL=

# World Bank Pink Sheet — Indicators API is open; optional CSV mirror if REST fails
# WB_PINK_JSON_URL=https://api.worldbank.org/v2/country/WLD/indicator/CRUDE_PETRO;MAIZE;RICE_INDICA?format=json&per_page=500&MRV=36
WB_PINK_CSV_URL=

# Goldprice.dev — Bearer key (weekly cadence stays within free tier)
GOLDPRICE_DEV_API_KEY=
# GOLDPRICE_DEV_URL=https://api.goldprice.dev/v1/prices

# Metals.dev — API key (query param + x-access-token sent; use as fallback only)
METALS_DEV_API_KEY=
# METALS_DEV_URL=https://api.metals.dev/v1/latest

# Frankfurter — optional URL override (`/v2/rates` is auto-built from `target_date`; legacy `/v2/latest` is obsolete upstream)

# exchangerate.host — optional; URL or access key for /live
EXCHANGERATE_HOST_URL=
EXCHANGERATE_HOST_API_KEY=

# EIA STEO — free API key at https://www.eia.gov/opendata/
EIA_API_KEY=

# Live integration tests (excluded from default CI)
# LIVE_API=1

# --- Pipeline ergonomics (`bun run pipeline` locally / CI shards) ---
# PIPELINE_MONTHS_LIMIT=12          # cap months processed when debugging backfills
# PIPELINE_MAX_COUNTRIES=20         # cap ISO2 iterations (still writes partial fixture JSON)
# PIPELINE_FRANKFURTER_DELAY_MS=500 # politeness pause between ECB historical pings
# PIPELINE_FROM=2020-01             # CLI alternative to --from=
# PIPELINE_TO=2026-04               # CLI alternative to --to=

# --- KKI closed API (Cloudflare Worker; set via `wrangler.jsonc` [vars] or dashboard) ---
# SUPABASE_PROJECT_REF=abcdxyz   # from https://abcdxyz.supabase.co
# SUPABASE_JWT_ISSUER=           # optional override; default https://<ref>.supabase.co/auth/v1
# SUPABASE_JWT_AUDIENCE=authenticated

# --- §3.6B static archive (monthly GitHub Release + mirrors) — matches GitHub Actions secret names in README ---
# GITHUB_TOKEN=                  # classic PAT with `repo` for releases (GH Actions: provided automatically)
# PINATA_JWT=                    # Pinata API JWT — Bearer token for IPFS pin API
# IA_S3_ACCESS_KEY=              # Internet Archive S3-like access key (archive.org/account/s3.php)
# IA_S3_SECRET_KEY=              # Internet Archive S3-like secret
